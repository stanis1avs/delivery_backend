# Шаблон переменных окружения бэкенда. Скопируйте в .env и заполните своими значениями.
# Реальный .env НЕ коммитить и НЕ класть в Docker-образ (см. .gitignore/.dockerignore, BUG-112).

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_NAME=delivery
DB_HOST=127.0.0.1
DB_PORT=5433

# Секрет сессии/токенов курьера (используется и express-session, и courierToken)
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change_me

# Сервер
PORT=7070
BACKEND_URL=http://localhost:7070
CLIENT_URL=http://localhost:3000

# Telegram Bot — получить у @BotFather. При утечке токена немедленно сделать revoke!
TELEGRAM_BOT_TOKEN=000000000:replace_with_your_bot_token

# OSRM (локально / внутри Docker)
OSRM_URL=http://localhost:5000

# Необязательно: окно «онлайн» курьера в секундах (по умолчанию 900)
# COURIER_ONLINE_WINDOW_SECONDS=900
