# Шаблон переменных окружения бэкенда. Скопируйте в .env и заполните своими значениями.
# Реальный .env НЕ коммитить и НЕ класть в Docker-образ (см. .gitignore/.dockerignore, BUG-112).

# PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_NAME=delivery
DB_HOST=127.0.0.1
DB_PORT=5433

# Секрет сессии/токенов курьера (используется и express-session, и courierToken)
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=change_me

# Сервер
PORT=7070
BACKEND_URL=http://localhost:7070
CLIENT_URL=http://localhost:3000

# Telegram Bot — получить у @BotFather. При утечке токена немедленно сделать revoke!
TELEGRAM_BOT_TOKEN=000000000:replace_with_your_bot_token

# OSRM (локально / внутри Docker)
OSRM_URL=http://localhost:5000

# Набор дорожных данных для контейнера osrm (файл в osrm_data/, без расширения .osrm).
# Маршруты строятся только внутри покрытия этого экстракта.
# OSRM_DATASET=new-jersey-latest

# Необязательно: окно «онлайн» курьера в секундах (по умолчанию 900)
# COURIER_ONLINE_WINDOW_SECONDS=900

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Номер логической базы. Тесты уводятся в отдельную (см. vitest.config.mjs),
# чтобы SCAN courier:*:status не видел ключи работающего приложения
# REDIS_DB=0

# Воркер распределения заказов. По умолчанию поднимается внутри index.js.
# false — если воркер запускается отдельным процессом (npm run worker)
# WORKER_IN_PROCESS=false
# WORKER_POLL_INTERVAL_MS=5000

# false — не поднимать Telegram-бота. Нужно для E2E: polling конфликтует
# с рабочим инстансом, Telegram отдаёт 409 на второй getUpdates
# TELEGRAM_ENABLED=false

# Подбор курьера: во сколько секунд пути обходится одна звезда рейтинга.
# Формула стоимости: время_в_пути − рейтинг × RATING_BONUS_SECONDS
# RATING_BONUS_SECONDS=30

# Пересчёт рейтинга: вес нового события в скользящем среднем.
# 0.2 — «память» примерно на десяток последних ответов курьера
# RELIABILITY_ALPHA=0.2
